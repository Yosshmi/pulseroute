# Copy to .env; scripts/setup.sh generates local credentials and encryption key.
DATABASE_URL=postgres://pulseroute:local-development-only@localhost:5432/pulseroute?sslmode=disable
POSTGRES_PASSWORD=local-development-only
REDIS_URL=redis://localhost:6379/0
ENCRYPTION_KEY=
PORT=8080
WORKER_PORT=8081
WORKERS=5
POLL_INTERVAL=500ms
HTTP_TIMEOUT=10s
LEASE_DURATION=60s
ALLOW_PRIVATE_ENDPOINTS=false
COOKIE_SECURE=true
STATIC_DIR=frontend/dist
# Local demo receiver only; generated by setup. Never use a production secret.
RECEIVER_SECRET=
